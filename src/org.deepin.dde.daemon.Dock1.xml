      <arg direction="out" type="i" name="Position"/>
    </signal>
    <signal name="WindowSizeEfficientChanged">
      <arg direction="out" type="u" name="size"/>
    </signal>
    <signal name="WindowSizeFashionChanged">
      <arg direction="out" type="u" name="size"/>
    </signal>
    <signal name="DisplayModeChanged">
      <arg direction="out" type="i" name="displaymode"/>
    </signal>
    <signal name="HideModeChanged">
      <arg direction="out" type="i" name="hideMode"/>
    </signal>
    <signal name="LockedChanged">
      <arg direction="out" type="b" name="locked"/>
    </signal>
</interface>
